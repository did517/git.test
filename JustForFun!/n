import javafx.application.Application;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.layout.StackPane;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.HBox;
import javafx.scene.paint.Color;
import javafx.stage.Stage;
import javafx.scene.shape.Rectangle;

public class ControlRectangle extends Application {

    RectanglePane rectanglePane = new RectanglePane();

    @Override
    public void start(Stage primaryStage) {
        // --- Boutons ---
        HBox hBox = new HBox();
        hBox.setSpacing(10);
        hBox.setAlignment(Pos.CENTER);

        Button btLeft = new Button("Left");
        Button btRight = new Button("Right");
        Button btUp = new Button("Up");
        Button btDown = new Button("Down");

        hBox.getChildren().addAll(btLeft, btRight, btUp, btDown);

        // --- Actions des boutons ---
        btLeft.setOnAction(e -> rectanglePane.left());
        btRight.setOnAction(e -> rectanglePane.right());
        btUp.setOnAction(e -> rectanglePane.up());
        btDown.setOnAction(e -> rectanglePane.down());

        // --- Layout principal ---
        BorderPane borderPane = new BorderPane();
        borderPane.setCenter(rectanglePane);   // <-- IMPORTANT
        borderPane.setBottom(hBox);
        BorderPane.setAlignment(hBox, Pos.CENTER);

        Scene scene = new Scene(borderPane, 300, 250);
        primaryStage.setTitle("ControlRectangle");
        primaryStage.setScene(scene);
        primaryStage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }

    class RectanglePane extends StackPane {
        private Rectangle rectangle = new Rectangle(60, 40);

        public RectanglePane() {
            rectangle.setStroke(Color.BLACK);
            rectangle.setFill(Color.WHITE);

            getChildren().add(rectangle);
        }

        public void right() { rectangle.setTranslateX(rectangle.getTranslateX() + 10); }
        public void left()  { rectangle.setTranslateX(rectangle.getTranslateX() - 10); }
        public void up()    { rectangle.setTranslateY(rectangle.getTranslateY() - 10); }
        public void down()  { rectangle.setTranslateY(rectangle.getTranslateY() + 10); }
    }
}

