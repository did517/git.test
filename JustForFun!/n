import javafx.animation.KeyFrame;
import javafx.animation.Timeline;
import javafx.util.Duration;
import javafx.scene.control.Label;

Label timerLabel = new Label("10"); // 10 secondes
int timeSeconds = 10;

Timeline timeline = new Timeline(new KeyFrame(Duration.seconds(1), event -> {
    int currentTime = Integer.parseInt(timerLabel.getText());
    if(currentTime > 0){
        timerLabel.setText(String.valueOf(currentTime - 1));
    } else {
        // Temps écoulé → mauvaise réponse automatique
        System.out.println("Time's up!");
    }
}));
timeline.setCycleCount(timeSeconds);
timeline.play();

