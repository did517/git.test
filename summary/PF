            fromLang = english;
            toLang = spanish;
        } else if (nativeLang == 3 && targetLang == 1) {
            fromLang = spanish;
            toLang = english;
        } else if (nativeLang == 2 && targetLang == 3) {
            fromLang = french;
            toLang = spanish;
        } else if (nativeLang == 3 && targetLang == 2) {
            fromLang = spanish;
            toLang = french;
        } else {
