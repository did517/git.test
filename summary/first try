import java.util.Scanner;

public class LanguagePractice {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Définir les langues avec leurs numéros
        String[][] languages = {
            {"1", "English"},
            {"2", "French"},
            {"3", "Spanish"}
        };

        // Demander à l'utilisateur ses choix
        System.out.println("Select your native language:");
        System.out.println("1. English\n2. French\n3. Spanish");
        int nativeLanguage = scanner.nextInt();

        System.out.println("Select the language you are learning:");
        System.out.println("1. English\n2. French\n3. Spanish");
        int learningLanguage = scanner.nextInt();

        // Chercher les noms correspondants
        String nativeLangName = "";
        String learningLangName = "";

        for (int i = 0; i < languages.length; i++) {
            if (Integer.parseInt(languages[i][0]) == nativeLanguage) {
                nativeLangName = languages[i][1];
            }
            if (Integer.parseInt(languages[i][0]) == learningLanguage) {
                learningLangName = languages[i][1];
            }
        }

        // Affichage final
        System.out.println("\nYour native language is: " + nativeLangName);
        System.out.println("You are learning: " + learningLangName);

        scanner.close();
    }
}








import java.util.Scanner;

public class LanguageSelection {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        String[][] Languages = {
            {"1", "English"},
            {"2", "French"},
            {"3", "Spanish"},
        };

        // Affichage du menu une seule fois
        System.out.println("Select your native language: (1 for English), (2 for French), (3 for Spanish)");
        String nativeLanguage = scanner.next();

        System.out.println("Select the language you are learning: (1 for English), (2 for French), (3 for Spanish)");
        String learningLanguage = scanner.next();

        String nativeLangName = "";
        String learningLangName = "";

        // Trouver le nom des langues sélectionnées
        for (int j = 0; j < Languages.length; j++) {
            if (Languages[j][0].equals(nativeLanguage)) {
                nativeLangName = Languages[j][1];
            }
            if (Languages[j][0].equals(learningLanguage)) {
                learningLangName = Languages[j][1];
            }
        }

        // Affichage final
        System.out.println("Your native language is: " + nativeLanguage + " → " + nativeLangName);
        System.out.println("You are learning: " + learningLanguage + " → " + learningLangName);

        scanner.close();
    }
}
















